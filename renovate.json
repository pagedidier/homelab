{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "rebaseConflictedPrs": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "separateMultipleMajor": true,
  "gitlabci": {
    "fileMatch": [
      "(^|/)\\.gitlab-ci\\.yml$",
      "(^|/)\\.gitlab/ci/.+\\.ya?ml$"
    ]
  },
  "helm-values": {
    "fileMatch": [
      "(^|/)values\\.yaml$",
      "(^|/)values\\.yaml\\.tmpl$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "(^|/)k8s/.+\\.ya?ml$"
    ]
  },
  "packageRules": [
    {
      "description": "Restrict docker image tags to semver X.Y.Z only",
      "matchDatasources": ["docker"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Limit concurrent PRs per package so major versions are applied one at a time",
      "matchUpdateTypes": ["major"],
      "groupName": "{{depName}} major"
    }
  ]
}