{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "group:monorepos",
    "workarounds:all"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "maxMajorIncrement": 1,
  "separateMultipleMajor": true,
  
  "semanticCommits": "auto",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],

  "gitlabci": {
    "managerFilePatterns": [
      "/(^|/)\\.gitlab-ci\\.yml$/",
      "/(^|/)\\.gitlab/ci/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.yaml$/",
      "/(^|/)values\\.yaml\\.tmpl$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.ya?ml$/"
    ]
  },

  "packageRules": [
    {
      "description": "Restrict docker image tags to semver X.Y.Z only",
      "matchDatasources": ["docker"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+(-.*)?$/"
    },
    {
      "description": "Limit concurrent PRs per package so major versions are applied one at a time",
      "matchUpdateTypes": ["major"],
      "groupName": "{{depName}} major"
    }
  ]
}