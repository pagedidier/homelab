{
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "maxMajorIncrement": 1,
  "separateMultipleMajor": true,
  
  "semanticCommits": "auto",
  "gitlabci": {
    "managerFilePatterns": [
      "/(^|/)\\.gitlab-ci\\.yml$/",
      "/(^|/)\\.gitlab/ci/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.yaml$/",
      "/(^|/)values\\.yaml\\.tmpl$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.ya?ml$/"
    ]
  },
  "pre-commit": {
    "enabled": true,
    "managerFilePatterns": [
      "/(^|/)\\.pre-commit-config\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Restrict docker image tags to semver X.Y.Z only",
      "matchDatasources": ["docker"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+(-.*)?$/"
    },
    {
      "description": "Limit concurrent PRs per package so major versions are applied one at a time",
      "matchUpdateTypes": ["major"],
      "groupName": "{{depName}} major"
    },
    {
      "description": "Automerge minor and patch updates for renovate/renovate",
      "matchPackageNames": ["renovate/renovate"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Group all pre-commit hook updates together",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    }
  ]
}