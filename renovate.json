{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "maxMajorIncrement": 1,
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "separateMultipleMajor": true,
  "gitlabci": {
    "managerFilePatterns": [
      "/(^|/)\\.gitlab-ci\\.yml$/",
      "/(^|/)\\.gitlab/ci/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.yaml$/",
      "/(^|/)values\\.yaml\\.tmpl$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Restrict docker image tags to semver X.Y.Z only",
      "matchDatasources": ["docker"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Limit concurrent PRs per package so major versions are applied one at a time",
      "matchUpdateTypes": ["major"],
      "groupName": "{{depName}} major"
    }
  ]
}
